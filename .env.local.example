# ============================================================
# AI Agent Portal 環境変数テンプレート
# 既定（このファイルをコピーしただけ）は MOCK_MODE 相当で動作します。
# 実接続に切り替えるには、以下を実値で埋めたうえで NEXT_PUBLIC_MOCK_MODE=false にします。
# ============================================================

# ==== Entra ID（サーバー：OBO 交換用）====
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret        # サーバーサイドのみ（ブラウザ非公開）

# ==== MSAL（ブラウザ公開）====
# クライアントの MSAL 初期化に必要。authority = login.microsoftonline.com/{TENANT}
NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id
NEXT_PUBLIC_AZURE_TENANT_ID=your-tenant-id
# OBO の assertion 用スコープ。既定は api://{NEXT_PUBLIC_AZURE_CLIENT_ID}/access_as_user。
# 「API の公開」で access_as_user を追加していれば未設定でOK（自動導出）。
# NEXT_PUBLIC_API_SCOPE=api://your-client-id/access_as_user

# ==== Foundry（新 Foundry ポータル ai.azure.com の Project endpoint をコピー）====
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=your-agent-name
# OBO 下流（Foundry）スコープ。既定 https://ai.azure.com/.default。
# テナントで通らなければ https://cognitiveservices.azure.com/.default に切替。
# FOUNDRY_OBO_SCOPE=https://ai.azure.com/.default

# ==== デモ設定 ====
# true（または未設定）＝モックデータで動作（会場ネットワーク障害時のフォールバック）。
# false ＝実接続（NEXT_PUBLIC_AZURE_CLIENT_ID / NEXT_PUBLIC_AZURE_TENANT_ID が揃う場合のみ有効。
#         揃わなければ安全側でモックにフォールバックします）。
NEXT_PUBLIC_MOCK_MODE=false

# Inside the Agent の1ステップ表示時間（ms）。開発=1000 / 本番=9500。範囲 1000–15000。
NEXT_PUBLIC_STEP_DELAY_MS=9500
