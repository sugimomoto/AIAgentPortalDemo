# ==== Entra ID ====
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret        # サーバーサイドのみ（ブラウザ非公開）

# ==== MSAL（ブラウザ公開）====
NEXT_PUBLIC_AZURE_CLIENT_ID=your-client-id

# ==== Foundry（新 Foundry ポータル ai.azure.com の Project endpoint をコピー）====
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=your-agent-name

# ==== デモ設定 ====
NEXT_PUBLIC_MOCK_MODE=false                   # true にするとモックデータで動作（会場ネットワーク障害時のフォールバック）
NEXT_PUBLIC_STEP_DELAY_MS=9500                # Inside the Agent の1ステップ表示時間（ms）。開発=1000 / 本番=9500
